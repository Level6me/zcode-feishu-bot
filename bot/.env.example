# =========================================================================
# Feishu / Lark App Credentials
# =========================================================================

# Complete official keys (Recommended)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternatively, short keys (also supported)
APP_ID=cli_xxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================================================================
# Access control
# -------------------------------------------------------------------------
# 新权限体系（推荐）：
#   首次部署后，第一个私聊会话自动绑定为最高管理员（admin）。
#   其他会话默认静默，发送 /auth 申请权限，管理员通过 /user 或授权卡片审批。
#
# 旧白名单兼容（可选，配置后命中者自动视为已授权 user，开发档权限）：
#   ALLOWED_USERS / ALLOWED_CHATS 为逗号分隔的 open_id / chat_id。
#   留空 = 完全走新权限体系（未授权会话不可用）。
# =========================================================================
ALLOWED_USERS=
ALLOWED_CHATS=

# =========================================================================
# ZCode engine (portability)
# =========================================================================

# Path to the zcode launcher (CLI script) or the bundled zcode.cjs.
# Leave empty for auto-detect (PATH -> /Applications/ZCode.app -> ~/.zcode).
ZCODE_BIN=

# Node interpreter used to run a bundled zcode.cjs (default: node in PATH).
ZCODE_NODE_BIN=

# zcode data root (credentials, memory, journals). Default: ~/.zcode
ZCODE_HOME=

# Engine provider & default model for the coding-plan account.
ZCODE_PROVIDER_ID=account:zai-start-plan
ZCODE_MODEL_ID=GLM-5.3

# Default bot-facing model (suffix -low/-medium/-high maps to engine
# reasoningLevel low/high/max). Examples: glm-5.3-flash / glm-5.3-flash-high
DEFAULT_MODEL=glm-5.3-flash-high

# Default workspace root used by the project browser card.
# Default: ~
WORKSPACE_ROOT=

# When true, run the engine in yolo (skip-permissions) mode for ADMIN chats only.
# Regular authorized users never get this flag, regardless of this setting.
# DANGEROUSLY_SKIP_PERMISSIONS=true

# Optional git mirror used by /update when GitHub is unreachable.
# May embed credentials, e.g. https://user:token@gitee.com/user/repo.git
GITEE_MIRROR_URL=

# =========================================================================
# TypeSafe AI (System One Decision & Guardrail Gateway)
# =========================================================================
# Get your API key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_ENABLED=true
TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# =========================================================================
# Docker Compose helpers (optional)
# =========================================================================
# HOST_ZCODE_HOME=${HOME}/.zcode
# HOST_WORKSPACE=${HOME}
